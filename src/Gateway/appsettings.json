{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "api-design-route": {
        "ClusterId": "api-design-cluster",
        "Match": {
          "Path": "/api/{projects,apispecs}/{**catch-all}"
        }
      },
      "data-dictionary-route": {
        "ClusterId": "data-dictionary-cluster",
        "Match": {
          "Path": "/api/{workspaces,datadictionaries,dataentities,dataattributes}/{**catch-all}"
        }
      },
      "governance-route": {
        "ClusterId": "governance-cluster",
        "Match": {
          "Path": "/api/{linkage,impactanalysis}/{**catch-all}"
        }
      },
      "mock-server-route": {
        "ClusterId": "mock-server-cluster",
        "Match": {
          "Path": "/api/mockserver/{**catch-all}"
        }
      },
      "linting-route": {
        "ClusterId": "linting-cluster",
        "Match": {
          "Path": "/api/{linting,rulesets}/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://auth-service:8080"
          }
        }
      },
      "api-design-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://api-design-service:8080"
          }
        }
      },
      "data-dictionary-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://data-dictionary-service:8080"
          }
        }
      },
      "governance-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://governance-service:8080"
          }
        }
      },
      "mock-server-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://mock-server-service:8080"
          }
        }
      },
      "linting-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://linting-service:8080"
          }
        }
      }
    }
  },
  "Cors": {
    "Origins": ["http://localhost:3000", "http://localhost:5000"]
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.Seq"],
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://seq:80" }
      }
    ]
  }
}
