# Database
POSTGRES_DB=apivia
POSTGRES_USER=apivia
POSTGRES_PASSWORD=YourStrongPassword123!
DATABASE_URL=postgresql://apivia:YourStrongPassword123!@postgres:5432/apivia

# RabbitMQ
RABBITMQ_DEFAULT_USER=apivia
RABBITMQ_DEFAULT_PASS=YourStrongPassword123!
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO
MINIO_ROOT_USER=apivia
MINIO_ROOT_PASSWORD=YourStrongPassword123!
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=apivia

# JWT
JWT_SECRET=YourSuperSecretJWTKeyThatIsAtLeast32CharactersLong!
JWT_ISSUER=apivia
JWT_AUDIENCE=apivia
JWT_EXPIRATION_MINUTES=60

# API URLs
API_GATEWAY_URL=http://gateway:8080
FRONTEND_URL=http://localhost:3000

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# Logging
SEQ_URL=http://seq:5341
SEQ_API_KEY=

# Environment
ASPNETCORE_ENVIRONMENT=Development
NODE_ENV=development
