# ==============================================
# APIVIA - Environment Variables Configuration
# ==============================================
# This file contains all required environment variables for the Apivia platform.
# Copy this file to .env and replace placeholder values with actual secrets.
# NEVER commit the .env file to version control!

# ==============================================
# APPLICATION ENVIRONMENT
# ==============================================
ASPNETCORE_ENVIRONMENT=Development
NODE_ENV=development

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
# PostgreSQL Database
POSTGRES_DB=apivia
POSTGRES_USER=apivia
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# Full database connection URL (auto-constructed from above or set manually)
DATABASE_URL=Host=postgres;Database=apivia;Username=apivia;Password=CHANGE_ME_STRONG_PASSWORD_HERE

# ==============================================
# CACHE & MESSAGE QUEUE
# ==============================================
# Redis Cache
REDIS_HOST=redis
REDIS_URL=redis:6379

# RabbitMQ Message Queue
RABBITMQ_HOST=rabbitmq
RABBITMQ_DEFAULT_USER=apivia
RABBITMQ_DEFAULT_PASS=CHANGE_ME_STRONG_PASSWORD_HERE

# ==============================================
# JWT AUTHENTICATION
# ==============================================
# CRITICAL: Must be at least 32 characters long!
# Generate a secure secret using: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_REQUIRED_FOR_SECURITY

JWT_ISSUER=apivia
JWT_AUDIENCE=apivia
JWT_EXPIRATION_MINUTES=60

# ==============================================
# CORS (Cross-Origin Resource Sharing)
# ==============================================
# Frontend URLs allowed to access the API
CORS_ORIGIN_1=http://localhost:3000
CORS_ORIGIN_2=http://localhost:5173

# ==============================================
# OBJECT STORAGE (MinIO)
# ==============================================
MINIO_ROOT_USER=apivia
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
MINIO_ENDPOINT=minio:9000

# ==============================================
# LOGGING & MONITORING
# ==============================================
# Seq Logging Server
SEQ_URL=http://seq:80

# ==============================================
# PRODUCTION DEPLOYMENT NOTES
# ==============================================
# For production deployments:
# 1. Generate strong, unique passwords for all *_PASSWORD variables
# 2. Generate a cryptographically secure JWT_SECRET (min 32 chars)
# 3. Update CORS_ORIGIN_* to match your production frontend domains
# 4. Set ASPNETCORE_ENVIRONMENT=Production
# 5. Update DATABASE_URL with production database credentials
# 6. Consider using a secrets management service (Azure Key Vault, AWS Secrets Manager, etc.)
# 7. Enable HTTPS/SSL for all services
# 8. Rotate secrets regularly

# ==============================================
# OPTIONAL: Service-Specific Overrides
# ==============================================
# Uncomment and customize these if you need service-specific configurations

# Gateway Service
# GATEWAY_PORT=5000

# Auth Service
# AUTH_SERVICE_PORT=8080

# API Design Service
# API_DESIGN_SERVICE_PORT=8080

# Data Dictionary Service
# DATA_DICTIONARY_SERVICE_PORT=8080

# Governance Service
# GOVERNANCE_SERVICE_PORT=8080

# Mock Server Service
# MOCK_SERVER_SERVICE_PORT=8080

# Linting Service
# LINTING_SERVICE_PORT=8080
